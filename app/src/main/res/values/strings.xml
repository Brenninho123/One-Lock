    <!-- Settings -->
    <string name="settings_about_title">Acerca de One Lock</string>
    <string name="settings_about_body">One Lock es un catálogo independiente que ayuda a encontrar y acceder a los módulos de Samsung Good Lock. La app no aloja, modifica ni redistribuye ningún APK: solo enlaza a páginas de descarga externas.</string>
    <string name="settings_version">Versión</string>
    <string name="settings_repository">Repositorio en GitHub</string>
    <string name="settings_disclaimer_title">Aviso legal</string>
    <string name="settings_disclaimer_body">One Lock es un proyecto independiente y no está afiliado, respaldado ni patrocinado por Samsung Electronics o Good Lock. Good Lock y sus módulos pertenecen a sus respectivos propietarios. One Lock únicamente proporciona información y enlaces externos hacia las páginas correspondientes.</string>
    <string name="settings_compat_title">Sobre la compatibilidad</string>
    <string name="settings_compat_body">Los estados de compatibilidad son orientativos y se basan en la versión mínima de Android indicada por cada módulo. Consulta siempre la página de descarga oficial antes de instalar cualquier módulo.</string>
